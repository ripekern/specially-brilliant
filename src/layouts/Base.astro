---
import "../styles/base.css";
import "../styles/components.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getSite, areaServedSchema, geoSchema, openingHoursSpecification, openingHours } from "../lib/content";
import { withBase } from "../lib/urls";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  type?: "website" | "article";
  /** Article-only OG properties. Ignored unless type="article". */
  publishedTime?: string;
  modifiedTime?: string;
  authorName?: string;
  /** Extra JSON-LD nodes, merged into the same @graph as the LocalBusiness. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  noindex = false,
  image,
  imageWidth = 1200,
  imageHeight = 630,
  imageAlt,
  type = "website",
  publishedTime,
  modifiedTime,
  authorName,
  schema,
} = Astro.props;
const site = await getSite();

// The brand suffix is added here and only here. A `seoTitle` is the page-name
// half of the tag, not the whole tag: appending to it twice is the one way this
// file can produce a title over the ~60 characters a search result shows.
const pageTitle =
  title === site.name ? `${site.name} — ${site.tagline}` : `${title} | ${site.name}`;
const metaDescription = description ?? site.tagline;

// Canonical always points at the production domain, so strip the deploy base
// path first: a preview served from /specially-brilliant/window-washing/ must
// still declare https://speciallybrilliant.com/window-washing/ as canonical.
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname;
const canonical = new URL(path, site.url).href;

// Every page gets a share image. Without one, a link pasted into a text thread
// or a chat renders as a bare URL, which is the most common way a local business
// gets found. The card is 1200x630, the size Facebook, LinkedIn and Slack expect.
// A per-page image must declare its real size: platforms reserve layout space from
// these tags, and a wrong pair leaves a letterboxed card or a cropped preview.
const ogImagePath = image ?? "/images/og-default.png";
const ogImage = new URL(ogImagePath, site.url).href;
const ogImageAlt = imageAlt ?? `${site.name} — ${site.tagline}`;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.legalName,
  description: site.tagline,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  foundingDate: String(site.since),
  // "$" rather than "$$": the published averages sit well under what comparable
  // operators charge, and a schema claiming mid-market pricing would contradict
  // what the page says. Google reads this alongside the visible prices.
  priceRange: "$",
  areaServed: areaServedSchema(site),
  geo: geoSchema(site),
  openingHours: openingHours(site),
  openingHoursSpecification: openingHoursSpecification(site),
  founder: { "@type": "Person", name: site.owner },
  sameAs: site.social?.facebook ? [site.social.facebook] : undefined,
};

const extra = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
// One @graph rather than several script tags: a single document keeps the
// entities cross-referenceable, which is what lets Google attach the service,
// the author and the business to the same result.
const ldJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [{ ...orgSchema, "@context": undefined }, ...extra],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    {/* article:* let Facebook, LinkedIn and Slack show a date and byline on a
        shared post, which measurably lifts clicks over a bare card. */}
    {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === "article" && authorName && <meta property="article:author" content={authorName} />}

    <meta name="theme-color" content="#0f3a5c" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap"
    />

    {base === "/" && <link rel="sitemap" href="/sitemap-index.xml" />}
    <link rel="icon" href={withBase("/logo.png")} type="image/png" sizes="any" />

    <script type="application/ld+json" set:html={ldJson} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
