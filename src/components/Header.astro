---
import { getSite, getServices, formatPhone } from "../lib/content";
import { services as serviceMeta } from "../data/services";
import { withBase } from "../lib/urls";
import BookingCta from "./BookingCta.astro";

const site = await getSite();
// Page titles are full SEO strings ("Quality Window Washing Service in Spokane
// Area"), which are far too long for navigation. Use the short card labels.
const services = (await getServices()).filter((s) => serviceMeta[s.data.slug]);

// Astro.url.pathname includes the deploy base (e.g. /specially-brilliant/...), so
// strip it before comparing against site-relative hrefs, or aria-current would
// silently stop matching on a subpath deploy.
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/+$/, "");
const current = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname;
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
// Two, not three: four nowrap nav links plus the phone and the CTA overflow the
// 72rem container. The services page is the hub for the full list.
const NAV_LIMIT = 2;
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href={withBase("/")}>
      <img class="header__logo" src={withBase("/logo.png")} alt="" width="44" height="44" />
      <span class="header__brandtext">
        <span class="header__name">Specially Brilliant</span>
        <span class="header__tagline">Window washing &amp; more</span>
      </span>
    </a>

    <nav class="header__nav" aria-label="Main">
      <a class="header__link" href={withBase("/services/")} aria-current={isActive("/services") ? "page" : undefined}>
        Services
      </a>
      {services.slice(0, NAV_LIMIT).map((s) => (
        <a
          class="header__link"
          href={withBase(`/${s.data.slug}/`)}
          aria-current={isActive(`/${s.data.slug}`) ? "page" : undefined}
        >
          {serviceMeta[s.data.slug].label}
        </a>
      ))}
      <a class="header__link" href={withBase("/about-us/")} aria-current={isActive("/about-us") ? "page" : undefined}>
        About
      </a>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={`tel:${site.phone}`}>{formatPhone(site.phone)}</a>
      <BookingCta class="btn btn--primary" />
    </div>
  </div>
</header>
