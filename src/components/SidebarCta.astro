---
import { getSite, formatPhone } from "../lib/content";
import BookingCta from "./BookingCta.astro";

const site = await getSite();
---

<div class="panel panel--accent">
  <h2>Get a free estimate</h2>
  <p>No obligation, and honest advice on what to do first.</p>
  <div class="stack" style="margin-top:var(--space-4)">
    <BookingCta class="btn btn--accent btn--block" label="Book online" />
    <a class="btn btn--ghost btn--block" href={`tel:${site.phone}`}>
      {formatPhone(site.phone)}
    </a>
  </div>
</div>

<div class="panel">
  <h2>Why people call us</h2>
  <ul class="features" style="margin-top:var(--space-3)">
    <li>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      <span>Free written estimate before any work starts</span>
    </li>
    <li>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      <span>Owner-operated since {site.since}</span>
    </li>
    <li>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      <span>Serving Spokane, the Valley and Coeur d'Alene</span>
    </li>
    <li>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      <span>The same person quotes the job and does the work</span>
    </li>
  </ul>
</div>
