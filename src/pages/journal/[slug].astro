---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getSite, getPosts } from "../../lib/content";
import { withBase } from "../../lib/urls";
import BookingCta from "../../components/BookingCta.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const site = await getSite();
const date = post.data.date
  ? new Date(post.data.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
  : "";
const postUrl = new URL(withBase(`/journal/${post.data.slug}/`), site.url).href;
const ogImagePath = post.data.image ?? "/images/og-default.png";
const ogImageUrl = new URL(withBase(ogImagePath), site.url).href;

// Cross-links. The prose already links out to the service pages, but each post
// also links to the other posts so no journal entry is a dead end.
const otherPosts = (await getPosts()).filter((p) => p.data.slug !== post.data.slug);

// Posts are their own entity type. Declaring BlogPosting lets the result carry
// the publish date and author, and the breadcrumb gives the search engine the
// hierarchy the visible breadcrumb already shows.
const schema = [
  {
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.seoDescription ?? post.data.description,
    url: postUrl,
    image: ogImageUrl,
    datePublished: post.data.date,
    dateModified: post.data.modified ?? post.data.date,
    author: { "@type": "Person", name: site.owner },
    publisher: { "@type": "Organization", name: site.legalName },
    mainEntityOfPage: postUrl,
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url },
      { "@type": "ListItem", position: 2, name: "Journal", item: new URL(withBase("/journal/"), site.url).href },
      { "@type": "ListItem", position: 3, name: post.data.title, item: postUrl },
    ],
  },
];
---

<Base
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.seoDescription ?? post.data.description}
  type="article"
  schema={schema}
  image={post.data.image}
  imageWidth={post.data.ogImageWidth}
  imageHeight={post.data.ogImageHeight}
  imageAlt={post.data.title}
  publishedTime={post.data.date}
  modifiedTime={post.data.modified ?? post.data.date}
  authorName={site.owner}
>
  <div class="pagehead">
    <div class="container">
      <p class="breadcrumb">
        <a href={withBase("/")}>Home</a> &rsaquo; <a href={withBase("/journal/")}>Journal</a>
      </p>
      <h1>{post.data.title}</h1>
      {date && <p class="pagehead__lede">{date}</p>}
    </div>
  </div>

  <div class="container with-aside">
    <article class="prose">
      <Content />
    </article>
    <aside class="aside">
      <div class="panel panel--accent">
        <h2>Need this done?</h2>
        <p>We cover {site.area.slice(0, -1).join(", ")} and {site.area.at(-1)}.</p>
        <div class="stack" style="margin-top:var(--space-4)">
          <BookingCta class="btn btn--accent btn--block" label="Get a free estimate" />
        </div>
      </div>

      {otherPosts.length > 0 && (
        <div class="panel">
          <h2>More from the journal</h2>
          <ul class="panel__list">
            {otherPosts.map((p) => (
              <li><a href={withBase(`/journal/${p.data.slug}/`)}>{p.data.title}</a></li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
</Base>
