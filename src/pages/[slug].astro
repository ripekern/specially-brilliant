---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import SidebarCta from "../components/SidebarCta.astro";
import { getSite, areaServedSchema, humanHours } from "../lib/content";
import { services as serviceMeta } from "../data/services";
import { withBase } from "../lib/urls";

export async function getStaticPaths() {
  // Astro hoists getStaticPaths out of module scope, so `reserved` has to live
  // inside the function body rather than at module level.
  const reserved = ["home", "services"];

  // Real collection entries are required here, not the {id, data} summaries that
  // getPages() returns: render() needs the entry itself to resolve <Content />.
  const entries = await getCollection("documents", ({ data }) => !data.draft);
  return entries
    .filter((e) => !reserved.includes(e.data.slug))
    .map((page) => ({
      params: { slug: page.data.slug },
      props: { page, meta: serviceMeta[page.data.slug] },
    }));
}

const { page, meta } = Astro.props;
const { Content } = await render(page);
const site = await getSite();
const { data } = page;
const isService = data.type === "service";
const label = meta?.label ?? data.title;
const hours = humanHours(site);
const openDays = site.hours.flatMap((block) => block.days);

// Service pages carry no description in their Markdown, so they used to fall
// back to the site tagline -- the same sentence on all six, which reads as thin
// or duplicated in results. The blurbs in services.ts are written per service
// and are what the cards already show, so they double as the meta description.
const metaDescription = data.seoDescription ?? data.description ?? meta?.blurb;

const pageUrl = new URL(withBase(`/${data.slug}/`), site.url).href;

// Per-page structured data. The LocalBusiness in Base covers the business, but
// each of these pages is a distinct entity: a service the business offers, or a
// post it published. Declaring them lets a result show a price, a rating hook or
// an author rather than just a blue link.
const crumbs = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    ...(data.type === "post"
      ? [{ "@type": "ListItem", position: 2, name: "Journal", item: new URL(withBase("/journal/"), site.url).href }]
      : []),
    { "@type": "ListItem", position: data.type === "post" ? 3 : 2, name: label, item: pageUrl },
  ],
};

const schema = [
  isService && {
    "@type": "Service",
    name: label,
    description: metaDescription,
    url: pageUrl,
    image: new URL(withBase(meta.image), site.url).href,
    serviceType: label,
    provider: { "@type": "LocalBusiness", name: site.legalName, telephone: site.phone },
    areaServed: areaServedSchema(site),
  },
  data.type === "post" && {
    "@type": "BlogPosting",
    headline: data.title,
    description: metaDescription,
    url: pageUrl,
    datePublished: data.date,
    dateModified: data.modified ?? data.date,
    author: { "@type": "Person", name: site.owner },
    publisher: { "@type": "Organization", name: site.legalName },
    mainEntityOfPage: pageUrl,
  },
  crumbs,
  // FAQPage is emitted only where the questions are visible on the page, which
  // is what earns the accordion result. The answers come from the same array the
  // template renders, so a question can never be marked up without being shown.
  data.faq.length > 0 && {
    "@type": "FAQPage",
    mainEntity: data.faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
].filter(Boolean);
---

<Base
  title={data.seoTitle ?? (isService ? label : data.title)}
  description={metaDescription}
  noindex={data.noindex}
  type={data.type === "post" ? "article" : "website"}
  schema={schema}
  image={data.image}
  imageWidth={data.ogImageWidth}
  imageHeight={data.ogImageHeight}
  imageAlt={data.title}
  publishedTime={data.date}
  modifiedTime={data.modified ?? data.date}
  authorName={site.owner}
>
  <div class="pagehead">
    <div class="container">
      {data.type === "post" && (
        <p class="breadcrumb">
          <a href={withBase("/")}>Home</a> &rsaquo; Journal
        </p>
      )}
      <h1>{isService ? label : data.title}</h1>
      {data.description && <p class="pagehead__lede">{data.description}</p>}
    </div>
  </div>

  <div class="container with-aside">
    <article class="prose">
      <Content />
    </article>

    {data.faq.length > 0 && (
      <section class="faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Common questions</h2>
        {data.faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </section>
    )}

    <aside class="aside">
      {data.showHours && (
        <div class="panel">
          <h2>Opening hours</h2>
          <ul class="panel__list">
            {hours.map((line) => <li>{line}</li>)}
            {!openDays.includes("Saturday") && <li>Closed Saturdays</li>}
          </ul>
        </div>
      )}
      <SidebarCta />
      {!isService && (
        <div class="panel">
          <h2>Our services</h2>
          <ul class="panel__list">
            <li><a href={withBase("/window-washing/")}>Window washing</a></li>
            <li><a href={withBase("/gutter-cleaning/")}>Gutter cleaning</a></li>
            <li><a href={withBase("/pressure-washing/")}>Pressure washing</a></li>
            <li><a href={withBase("/automobile-detailing/")}>Auto detailing</a></li>
            <li><a href={withBase("/house-painting/")}>House painting</a></li>
            <li><a href={withBase("/moss-removal/")}>Roof moss removal</a></li>
          </ul>
        </div>
      )}
    </aside>
  </div>
</Base>
