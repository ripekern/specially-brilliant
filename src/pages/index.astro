---
import Base from "../layouts/Base.astro";
import { getSite, getServices, formatPhone } from "../lib/content";
import ServiceCard from "../components/ServiceCard.astro";
import { services as serviceMeta } from "../data/services";
import { withBase } from "../lib/urls";
import BookingCta from "../components/BookingCta.astro";

const site = await getSite();
const services = await getServices();
---

<Base
  title="Window Washing in Spokane & the Valley"
  description="Window washing, gutter cleaning, pressure washing, auto detailing, house painting and roof moss removal in Spokane, the Spokane Valley and Coeur d'Alene."
>
  <section class="hero">
    <div class="container hero__inner">
      <div>
        <span class="hero__eyebrow">Serving Spokane &amp; Coeur d'Alene since {site.since}</span>
        <h1>A clearer view of your home.</h1>
        <p class="hero__lede">
          Professional window washing, gutter cleaning, pressure washing, auto detailing, house
          painting and roof moss removal. Owner-operated, free estimates, and no subcontractor on
          your property.
        </p>
        <div class="hero__actions">
          <BookingCta class="btn btn--accent btn--lg" label="Get a free estimate" />
          <a class="btn btn--ghost btn--lg" href={`tel:${site.phone}`}>
            Call {formatPhone(site.phone)}
          </a>
        </div>
        <div class="hero__proof">
          <span class="hero__proof-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            Free estimates
          </span>
          <span class="hero__proof-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            No subcontractors
          </span>
          <span class="hero__proof-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            Owner-operated since {site.since}
          </span>
        </div>
      </div>
      <div class="hero__media">
        <img
          src={withBase("/images/hero-window-washer.webp")}
          alt="A window washer cleaning the glass of a home in the Spokane Valley"
          width="1024"
          height="768"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head section__head--center">
        <h2>What we do</h2>
        <p>
          Six services, one local team. Most homes need two or three of them on a schedule rather
          than all at once, and we will tell you which to prioritize so nothing gets missed.
        </p>
      </div>
      <div class="grid grid--3">
        {services.map((s) => {
          const meta = serviceMeta[s.data.slug] ?? {};
          return (
            <ServiceCard
              title={s.data.title}
              slug={s.data.slug}
              description={s.data.description}
              image={meta.image}
              icon={meta.icon}
            />
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section__head section__head--center">
        <h2>How it works</h2>
        <p>No pressure. Three steps and we are done.</p>
      </div>
      <ol class="steps">
        <li>
          <h3>Tell us what you need</h3>
          <p>
            Book online in a couple of minutes, or call and describe the job. Photos help if you
            are not sure which service it is.
          </p>
        </li>
        <li>
          <h3>Get a free estimate</h3>
          <p>
            You get a clear price before anything starts. Problems caught early are what keep them
            from turning into a replacement later.
          </p>
        </li>
        <li>
          <h3>We do the work</h3>
          <p>
            Owner-operated, with the same person quoting the job and doing it. Payment
            on completion.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>Questions people ask</h2>
      </div>
      <div class="faq">
        <details>
          <summary>Why are your prices so much lower than everyone else's?</summary>
          <p>
            Because there is no company behind the price. {site.owner.split(" ")[0]} does the work
            himself — no office, no sales staff, no subcontractor sent to your house in his place.
            What is left after those costs come out is close to the cost of the job itself. Window
            washing averages around $119 on a typical home, gutter cleaning around $150, and a full auto
            detail around $180.
          </p>
          <p>
            And the low number is the number. It is fixed in writing before we start, so it is not a
            lead-in figure waiting to grow once we are up the ladder. Specially Brilliant is
            owner-operated, with the same person who quotes the job doing it — there is nothing about
            a one-person operation that lets a job be done for less than it takes to do it properly.
          </p>
        </details>
        <details>
          <summary>Do I need to be home while you work?</summary>
          <p>
            Not necessarily. Many customers are at work. We can text you photos when we finish, and
            you can settle payment remotely.
          </p>
        </details>
        <details>
          <summary>How often should gutters be cleaned?</summary>
          <p>
            Twice a year is the usual answer in this region, and more if you have trees close to
            the roof. Clogged gutters cause ice dams in winter, which is expensive to fix.
          </p>
        </details>
        <details>
          <summary>Do you cover areas outside Spokane?</summary>
          <p>
            Yes. We work across {site.area.slice(0, -1).join(", ")} and {site.area.at(-1)}, along
            with the smaller communities between them, and further afield for larger jobs. Travel
            is included in the estimate. The
            <a href={withBase("/service-area/")}>full service area</a> lists every town we cover.
          </p>
        </details>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Ready for a free estimate?</h2>
      <p>
        Tell us what your property needs. Maintenance costs a fraction of replacement: cleaned glass
        instead of new windows, a cleared roof instead of new shingles, siding washed instead of
        replaced, a detailed car instead of a new one. We will quote it honestly and tell you what
        to do first.
      </p>
      <div class="cta-band__actions">
        <BookingCta class="btn btn--accent btn--lg" label="Book a visit" />
        <a class="btn btn--ghost btn--lg" href={`tel:${site.phone}`}>Call now</a>
      </div>
    </div>
  </section>
</Base>
